{
  "name": "inspired-ui",
  "version": "0.1.0",
  "description": "Design tokens + React component library powering inspiredeffect.com. Built on shadcn/ui primitives with a custom violet/engineered palette.",
  "type": "module",
  "license": "MIT",
  "author": "Dywayne Johnson <djohnsonkc@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/djohnsonkc/inspired-ui.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tokens": "./dist/inspired-tokens.css",
    "./styles": "./dist/inspired-tokens.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run build:lib && npm run build:css",
    "build:lib": "vite build",
    "build:css": "vite build --config vite.css.config.ts",
    "pack:dev": "npm run build && node scripts/pack.cjs",
    "clean": "rimraf dist *.tgz"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "tailwind-merge": "^2.5.4",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "rimraf": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.3.0"
  }
}
